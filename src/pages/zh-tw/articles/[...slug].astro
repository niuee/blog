---
import { buildArticlePaths } from '../../../lib/article-build';
import ArticlePage from '../../../components/ArticlePage.astro';
export async function getStaticPaths() {
  return buildArticlePaths('zh-tw');
}
const { entry, locale, seriesContext, availableLanguages } = Astro.props;
---
<ArticlePage
  entry={entry}
  locale={locale}
  seriesContext={seriesContext}
  availableLanguages={availableLanguages}
/>
