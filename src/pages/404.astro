---
import BlogLayout from '../layouts/BlogLayout.astro';
---
<BlogLayout title="404 - Page Not Found" lang="en">
  <header>
    <h1>404</h1>
    <div class="meta">Page Not Found</div>
  </header>
  <div id="blog-content">
    <article>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <p>
        <a href="/">Return to homepage</a> or
        <a href="/articles">browse articles</a>.
      </p>
    </article>
  </div>
</BlogLayout>
