---
import { render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import ArticleHeader from './ArticleHeader.astro';
import SeriesNav from './SeriesNav.astro';
export interface Props {
  entry: any;
  locale: string;
  seriesContext: any | null;
  availableLanguages: (string | null)[];
}
const { entry, locale, seriesContext, availableLanguages } = Astro.props;
const { Content } = await render(entry);
const { title, published, date, author, tags } = entry.data;
---
<BlogLayout title={title} lang={locale} bodyMode="article" availableLanguages={availableLanguages}>
  <ArticleHeader title={title} date={published ?? date} author={author} />
  {/* Pagefind indexes only elements marked data-pagefind-body (multiple regions
      per page are merged). Tags are exposed as filters via attribute capture. */}
  <div id="blog-content" data-pagefind-body>
    {(tags ?? []).map((tag: string) => (
      <meta data-pagefind-filter="tag[content]" content={tag} />
    ))}
    <article>
      {seriesContext ? (
        <SeriesNav {...seriesContext}><Content /></SeriesNav>
      ) : (
        <Content />
      )}
    </article>
  </div>
</BlogLayout>
