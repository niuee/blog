---
export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;

// Server-rendered labels mirror the client-side tables in
// blog-language-selector.js, which re-translates these links on pages where
// the language selector is active.
const LABELS: Record<string, { home: string; articles: string; series: string; search: string }> = {
  en: { home: 'Home', articles: 'Articles', series: 'Series', search: 'Search' },
  'zh-tw': { home: '首頁', articles: '文章', series: '系列', search: '搜尋' },
};

const labels = LABELS[locale] ?? LABELS.en;
const prefix = locale === 'en' ? '' : `/${locale}`;
---
<nav class="sticky-nav site-nav-wrapper" id="sticky-nav">
  <div class="site-nav" aria-label="Site navigation">
    {/* Home has no zh-tw variant, so it always points at the root. */}
    <a href="/" class="site-nav-link" id="nav-link-home">{labels.home}</a>
    <a href={`${prefix}/articles`} class="site-nav-link" id="nav-link-articles">{labels.articles}</a>
    <a href={`${prefix}/series`} class="site-nav-link" id="nav-link-series">{labels.series}</a>
    <a href={`${prefix}/search`} class="site-nav-link" id="nav-link-search">{labels.search}</a>
  </div>
</nav>
