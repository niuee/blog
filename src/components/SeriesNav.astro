---
export interface Props {
  seriesSlug: string;
  seriesTitle: string;
  index: number; // 0-based position
  total: number;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
  localePrefix?: string; // '' for en, '/zh-tw' for zh-tw
}
const {
  seriesSlug,
  seriesTitle,
  index,
  total,
  prev,
  next,
  localePrefix = '',
} = Astro.props;
---

<div id="series-nav" class="series-nav" data-pagefind-ignore>
  <span>Part {index + 1} of {total}</span>
  {' '}
  <a href={`${localePrefix}/series/${seriesSlug}`}>{seriesTitle}</a>
</div>
<slot />
{
  (prev || next) && (
    <div id="series-nav-bottom" class="series-nav-bottom" data-pagefind-ignore>
      <div class="series-nav-bottom-row">
        {prev ? (
          <a
            class="series-nav-bottom-card series-nav-bottom-prev"
            href={`${localePrefix}/articles/${prev.slug}`}
          >
            <span class="series-nav-bottom-label">← Prev</span>
            <span class="series-nav-bottom-title">{prev.title}</span>
          </a>
        ) : (
          <span class="series-nav-bottom-spacer" />
        )}
        {next ? (
          <a
            class="series-nav-bottom-card series-nav-bottom-next"
            href={`${localePrefix}/articles/${next.slug}`}
          >
            <span class="series-nav-bottom-label">Next →</span>
            <span class="series-nav-bottom-title">{next.title}</span>
          </a>
        ) : (
          <span class="series-nav-bottom-spacer" />
        )}
      </div>
    </div>
  )
}

<style>
  .series-nav {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    color: var(--text-meta-color, #6b7280);
  }
  .series-nav a {
    color: var(--link-unvisited-color, var(--link-color));
    text-decoration: none;
    border-bottom: 1px solid
      var(--link-decoration-unvisited-color, var(--link-decoration-color));
    padding-bottom: 1px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .series-nav a:hover {
    color: var(--link-hover-color);
    border-bottom-color: var(--link-decoration-hover-color);
  }
  .series-nav a:visited {
    color: var(--link-visited-color);
    border-bottom-color: var(--link-decoration-visited-color);
  }
  .series-nav a:visited:hover {
    color: var(--link-hover-color);
    border-bottom-color: var(--link-decoration-hover-color);
  }
  .series-nav-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--table-border-color, rgba(0, 0, 0, 0.1));
  }
  .series-nav-bottom-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: stretch;
  }
  /* Kill UA blue/purple on <a>: children set their own colors via spans */
  .series-nav-bottom-card:any-link,
  .series-nav-bottom-card:any-link:visited,
  .series-nav-bottom-card:any-link:hover,
  .series-nav-bottom-card:any-link:active {
    color: inherit;
  }
  .series-nav-bottom-card {
    flex: 1 1 220px;
    max-width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--table-border-color, rgba(0, 0, 0, 0.1));
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    background: transparent;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
    box-sizing: border-box;
  }
  /* Match article links + table row hover (blog-styles / dark-mode tokens), not TLDR blue */
  .series-nav-bottom-card:hover {
    border-color: var(--link-decoration-hover-color);
    background-color: var(--table-row-hover-bg);
  }
  .series-nav-bottom-next {
    text-align: right;
    margin-left: auto;
  }
  .series-nav-bottom-spacer {
    flex: 1 1 220px;
    min-width: 0;
  }
  .series-nav-bottom-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-meta-color, #6b7280);
    margin-bottom: 0.35rem;
  }
  .series-nav-bottom-title {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--link-unvisited-color, var(--link-color));
    transition: color 0.2s ease;
  }
  .series-nav-bottom-card:visited .series-nav-bottom-title {
    color: var(--link-visited-color);
  }
  .series-nav-bottom-card:hover .series-nav-bottom-title,
  .series-nav-bottom-card:visited:hover .series-nav-bottom-title {
    color: var(--link-hover-color);
    text-decoration: underline;
    text-decoration-color: var(--link-decoration-hover-color);
  }
</style>
