---
import BlogLayout from '../layouts/BlogLayout.astro';

export interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;

// Server-rendered strings plus the translation pack handed to PagefindUI.
const STRINGS: Record<
  string,
  { title: string; subtitle: string; unavailable: string; ui: Record<string, string> }
> = {
  en: {
    title: 'Search',
    subtitle: 'Full-text search across all articles',
    unavailable:
      'Search is unavailable — the search index is only generated by a production build (pnpm build && pnpm preview).',
    ui: {},
  },
  'zh-tw': {
    title: '搜尋',
    subtitle: '全文搜尋所有文章',
    unavailable: '搜尋功能目前無法使用——搜尋索引只會在正式建置時產生（pnpm build && pnpm preview）。',
    ui: {
      placeholder: '搜尋文章',
      clear_search: '清除',
      load_more: '載入更多結果',
      search_label: '搜尋本站',
      filters_label: '篩選',
      zero_results: '找不到符合「[SEARCH_TERM]」的結果',
      many_results: '「[SEARCH_TERM]」共有 [COUNT] 筆結果',
      one_result: '「[SEARCH_TERM]」共有 [COUNT] 筆結果',
      alt_search: '找不到符合「[SEARCH_TERM]」的結果，改為顯示「[DIFFERENT_TERM]」的結果',
      search_suggestion: '找不到符合「[SEARCH_TERM]」的結果，試試以下搜尋：',
      searching: '正在搜尋「[SEARCH_TERM]」…',
    },
  },
};

const t = STRINGS[locale] ?? STRINGS.en;
---
<BlogLayout title={t.title} lang={locale} bodyMode="article" availableLanguages={[null, 'zh-tw']}>
  <header class="search-header">
    <h1>{t.title}</h1>
    <p class="subtitle">{t.subtitle}</p>
  </header>
  {/* The Pagefind bundle is emitted into dist/pagefind/ by `pagefind --site dist`
      after the Astro build, so these URLs only resolve on a built site. */}
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <div id="search"></div>
  <p id="search-unavailable" class="search-unavailable" hidden>{t.unavailable}</p>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline define:vars={{ uiTranslations: t.ui }}>
    (function () {
      function init() {
        if (typeof PagefindUI === 'undefined') {
          var notice = document.getElementById('search-unavailable');
          if (notice) notice.hidden = false;
          return;
        }
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: uiTranslations,
        });
        var input = document.querySelector('#search input');
        if (input) input.focus();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</BlogLayout>
<style is:global>
  .search-header {
    margin-bottom: 2rem;
  }

  .search-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .search-header .subtitle {
    color: var(--text-meta-color);
    font-size: 1.1rem;
  }

  .search-unavailable {
    color: var(--text-meta-color);
  }

  /* Theme Pagefind's default UI with the site palette; the variables track
     dark mode automatically because they are redefined on [data-blog-dark]. */
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--text-color);
    --pagefind-ui-text: var(--text-color);
    --pagefind-ui-background: var(--bg-color);
    --pagefind-ui-border: var(--table-border-color);
    --pagefind-ui-tag: var(--inline-code-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: inherit;
  }

  #search .pagefind-ui__result-link {
    color: var(--link-unvisited-color);
  }

  #search .pagefind-ui__result-link:hover {
    color: var(--link-hover-color);
  }

  #search mark {
    background: var(--emphasis-bg);
    color: var(--emphasis-text-color);
  }
</style>
