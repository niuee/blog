<!-- Image Viewer Overlay -->
<div class="image-viewer-overlay" id="image-viewer-overlay">
  <button class="image-viewer-close" id="image-viewer-close" aria-label="Close image viewer">×</button>
  <div class="image-viewer-container" id="image-viewer-container">
    <img class="image-viewer-img" id="image-viewer-img" src="" alt="" />
  </div>
  <div class="image-viewer-controls">
    <button class="image-viewer-btn" id="image-viewer-zoom-out" aria-label="Zoom out">−</button>
    <span class="image-viewer-zoom-level" id="image-viewer-zoom-level">100%</span>
    <button class="image-viewer-btn" id="image-viewer-zoom-in" aria-label="Zoom in">+</button>
    <button class="image-viewer-btn" id="image-viewer-reset" aria-label="Reset view">Reset</button>
  </div>
</div>
